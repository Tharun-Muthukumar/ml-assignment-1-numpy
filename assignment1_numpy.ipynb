{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "77477dcb",
   "metadata": {
    "id": "77477dcb"
   },
   "source": [
    "# Assignment 1: NumPy\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "01753190",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:31.617284Z",
     "iopub.status.busy": "2026-10-04T09:18:31.617284Z",
     "iopub.status.idle": "2026-10-04T09:18:35.618331Z",
     "shell.execute_reply": "2026-10-04T09:18:35.618331Z"
    },
    "id": "01753190"
   },
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from numpy.lib.stride_tricks import sliding_window_view\n",
    "from time import perf_counter\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a580018c",
   "metadata": {
    "id": "a580018c"
   },
   "source": [
    "## 1. Generate the array and compare storage"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "90d18cdf",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.634427Z",
     "iopub.status.busy": "2026-10-04T09:18:35.618331Z",
     "iopub.status.idle": "2026-10-04T09:18:35.658660Z",
     "shell.execute_reply": "2026-10-04T09:18:35.658660Z"
    },
    "id": "90d18cdf",
    "outputId": "d8762d32-857c-4b4e-978c-ac4e6d838624"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape: (1000, 5) dtype: float64 bytes: 40000\n",
      "After conversion: float32 bytes: 20000\n"
     ]
    }
   ],
   "source": [
    "A = np.random.normal(50, 12, size=(1000, 5))\n",
    "print(\"Shape:\", A.shape, \"dtype:\", A.dtype, \"bytes:\", A.nbytes)\n",
    "A = A.astype(np.float32)\n",
    "print(\"After conversion:\", A.dtype, \"bytes:\", A.nbytes)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f2aa0de4",
   "metadata": {
    "id": "f2aa0de4"
   },
   "source": [
    "## 2. Standardise columns\n",
    "\n",
    "Keep A in its original units; use a separate standardised array."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b19c35a6",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.666371Z",
     "iopub.status.busy": "2026-10-04T09:18:35.666371Z",
     "iopub.status.idle": "2026-10-04T09:18:35.703154Z",
     "shell.execute_reply": "2026-10-04T09:18:35.703154Z"
    },
    "id": "b19c35a6",
    "outputId": "dc194345-5f25-42c2-bf3f-947f27ba1d5c"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Means: [-0.  0.  0.  0.  0.]\n",
      "Standard deviations: [1. 1. 1. 1. 1.]\n"
     ]
    }
   ],
   "source": [
    "standardised = (A - A.mean(axis=0, keepdims=True, dtype=np.float64)) / A.std(axis=0, keepdims=True, dtype=np.float64)\n",
    "print(\"Means:\", standardised.mean(axis=0).round(6))\n",
    "print(\"Standard deviations:\", standardised.std(axis=0).round(6))\n",
    "assert np.allclose(standardised.mean(axis=0), 0, atol=2e-6)\n",
    "assert np.allclose(standardised.std(axis=0), 1, atol=2e-6)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3f920d3e",
   "metadata": {
    "id": "3f920d3e"
   },
   "source": [
    "## 3. Min-max scaling along either axis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "3a372017",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.714106Z",
     "iopub.status.busy": "2026-10-04T09:18:35.714106Z",
     "iopub.status.idle": "2026-10-04T09:18:35.750077Z",
     "shell.execute_reply": "2026-10-04T09:18:35.750077Z"
    },
    "id": "3a372017",
    "outputId": "487f4000-344e-4c77-94d0-60ca0180ff5f"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Column minima: [0. 0. 0. 0. 0.]\n",
      "Column maxima: [1. 1. 1. 1. 1.]\n",
      "Row minima range: 0.0 0.0\n",
      "Row maxima range: 1.0 1.0\n"
     ]
    }
   ],
   "source": [
    "def minmax(X, axis):\n",
    "    low = np.min(X, axis=axis, keepdims=True)\n",
    "    span = np.max(X, axis=axis, keepdims=True) - low\n",
    "    return np.divide(X - low, span, out=np.zeros_like(X, dtype=float), where=span != 0)\n",
    "\n",
    "column_scaled = minmax(A, axis=0)\n",
    "row_scaled = minmax(A, axis=1)\n",
    "print(\"Column minima:\", column_scaled.min(axis=0))\n",
    "print(\"Column maxima:\", column_scaled.max(axis=0))\n",
    "print(\"Row minima range:\", row_scaled.min(axis=1).min(), row_scaled.min(axis=1).max())\n",
    "print(\"Row maxima range:\", row_scaled.max(axis=1).min(), row_scaled.max(axis=1).max())\n",
    "assert np.allclose(column_scaled.min(axis=0), 0) and np.allclose(column_scaled.max(axis=0), 1)\n",
    "assert np.allclose(row_scaled.min(axis=1), 0) and np.allclose(row_scaled.max(axis=1), 1)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8a6b18cc",
   "metadata": {
    "id": "8a6b18cc"
   },
   "source": [
    "## 4. Inject and fill missing values\n",
    "\n",
    "Sampling without replacement makes exactly 5% of positions missing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "772862a9",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.762448Z",
     "iopub.status.busy": "2026-10-04T09:18:35.750077Z",
     "iopub.status.idle": "2026-10-04T09:18:35.794681Z",
     "shell.execute_reply": "2026-10-04T09:18:35.794681Z"
    },
    "id": "772862a9",
    "outputId": "d8063b5c-d2d0-4390-9f73-74d76d26898a"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Missing before: 250\n",
      "Missing after: 0\n"
     ]
    }
   ],
   "source": [
    "positions = np.random.choice(A.size, size=int(A.size * 0.05), replace=False)\n",
    "A.flat[positions] = np.nan\n",
    "print(\"Missing before:\", np.isnan(A).sum())\n",
    "missing = np.isnan(A)\n",
    "column_means = np.nanmean(A, axis=0, keepdims=True)\n",
    "A = np.where(missing, column_means, A)\n",
    "print(\"Missing after:\", np.isnan(A).sum())\n",
    "assert np.isnan(A).sum() == 0"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a3b9972b",
   "metadata": {
    "id": "a3b9972b"
   },
   "source": [
    "## 5. Replace outliers using column medians"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "022faa29",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.810737Z",
     "iopub.status.busy": "2026-10-04T09:18:35.794681Z",
     "iopub.status.idle": "2026-10-04T09:18:35.843031Z",
     "shell.execute_reply": "2026-10-04T09:18:35.843031Z"
    },
    "id": "022faa29",
    "outputId": "c47c514f-648c-40df-c9bc-a8a27aa0d6f1"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Replaced per column: [5 1 5 3 5]\n"
     ]
    }
   ],
   "source": [
    "outliers = np.abs(A - A.mean(axis=0, keepdims=True)) > 3 * A.std(axis=0, keepdims=True)\n",
    "print(\"Replaced per column:\", outliers.sum(axis=0))\n",
    "A = np.where(outliers, np.median(A, axis=0, keepdims=True), A)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dc054dde",
   "metadata": {
    "id": "dc054dde"
   },
   "source": [
    "## 6. Pairwise Euclidean distances"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "54678490",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.843031Z",
     "iopub.status.busy": "2026-10-04T09:18:35.843031Z",
     "iopub.status.idle": "2026-10-04T09:18:35.893574Z",
     "shell.execute_reply": "2026-10-04T09:18:35.893574Z"
    },
    "id": "54678490",
    "outputId": "4ff34d98-59ba-4af3-d1e3-591212ab0f65"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape: (200, 200)\n",
      "Zero diagonal: True\n",
      "Symmetric: True\n"
     ]
    }
   ],
   "source": [
    "first = A[:200].astype(np.float64)\n",
    "distances = np.sqrt(np.sum((first[:, None, :] - first[None, :, :]) ** 2, axis=2))\n",
    "print(\"Shape:\", distances.shape)\n",
    "print(\"Zero diagonal:\", np.allclose(np.diag(distances), 0))\n",
    "print(\"Symmetric:\", np.allclose(distances, distances.T))\n",
    "assert np.allclose(np.diag(distances), 0)\n",
    "assert np.allclose(distances, distances.T)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b6389fae",
   "metadata": {
    "id": "b6389fae"
   },
   "source": [
    "## 7. Find five nearest neighbours\n",
    "\n",
    "argpartition selects the five smallest distances without sorting all 200 entries in each row."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "9818c963",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.905963Z",
     "iopub.status.busy": "2026-10-04T09:18:35.905963Z",
     "iopub.status.idle": "2026-10-04T09:18:35.954020Z",
     "shell.execute_reply": "2026-10-04T09:18:35.954020Z"
    },
    "id": "9818c963",
    "outputId": "c33bc0c1-81b4-4e83-dc24-eeb0b434b2b2"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape: (200, 5) dtype: int64\n",
      "First five rows:\n",
      " [[180 179 116 178 192]\n",
      " [114  17  31 112 197]\n",
      " [  3 158 132 145 102]\n",
      " [132   2 101   5 194]\n",
      " [160 158 143 102  43]]\n"
     ]
    }
   ],
   "source": [
    "candidate_distances = distances.copy()\n",
    "np.fill_diagonal(candidate_distances, np.inf)\n",
    "nearest = np.argpartition(candidate_distances, kth=4, axis=1)[:, :5]\n",
    "selected_distances = np.take_along_axis(candidate_distances, nearest, axis=1)\n",
    "nearest = np.take_along_axis(nearest, np.argsort(selected_distances, axis=1), axis=1)\n",
    "print(\"Shape:\", nearest.shape, \"dtype:\", nearest.dtype)\n",
    "print(\"First five rows:\\n\", nearest[:5])\n",
    "assert nearest.shape == (200, 5)\n",
    "assert not np.any(nearest == np.arange(200)[:, None])\n",
    "assert np.all(np.max(np.take_along_axis(candidate_distances, nearest, axis=1), axis=1) <= np.partition(candidate_distances, 4, axis=1)[:, 4])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3ab77c6b",
   "metadata": {
    "id": "3ab77c6b"
   },
   "source": [
    "## 8. Compare counting times\n",
    "\n",
    "Both cells use %%time. perf_counter also records comparable operation timings so the speed-up can be calculated. The loop below is explicitly required by this question. A single timing varies with hardware and system load."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d1e929a4",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:35.954020Z",
     "iopub.status.busy": "2026-10-04T09:18:35.954020Z",
     "iopub.status.idle": "2026-10-04T09:18:36.009841Z",
     "shell.execute_reply": "2026-10-04T09:18:36.009841Z"
    },
    "id": "d1e929a4"
   },
   "outputs": [],
   "source": [
    "values = np.random.randint(0, 100, size=1_000_000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "761f4800",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.017992Z",
     "iopub.status.busy": "2026-10-04T09:18:36.017992Z",
     "iopub.status.idle": "2026-10-04T09:18:36.054441Z",
     "shell.execute_reply": "2026-10-04T09:18:36.054441Z"
    },
    "id": "761f4800",
    "outputId": "c56e4e76-0932-446e-b6c3-46e7d449ba0f"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU times: user 3.2 ms, sys: 29 µs, total: 3.23 ms\n",
      "Wall time: 2.73 ms\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "start = perf_counter()\n",
    "vector_counts = np.bincount(values, minlength=100)\n",
    "vector_seconds = perf_counter() - start"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "d1e2efcf",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.065992Z",
     "iopub.status.busy": "2026-10-04T09:18:36.065992Z",
     "iopub.status.idle": "2026-10-04T09:18:36.514871Z",
     "shell.execute_reply": "2026-10-04T09:18:36.514871Z"
    },
    "id": "d1e2efcf",
    "outputId": "d64d7197-6163-4052-e79d-ad29f4ff6ec5"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU times: user 214 ms, sys: 0 ns, total: 214 ms\n",
      "Wall time: 217 ms\n"
     ]
    }
   ],
   "source": [
    "%%time\n",
    "start = perf_counter()\n",
    "loop_counts = [0] * 100\n",
    "for value in values:\n",
    "    loop_counts[value] += 1\n",
    "loop_seconds = perf_counter() - start"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "57ffa2aa",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.523407Z",
     "iopub.status.busy": "2026-10-04T09:18:36.523407Z",
     "iopub.status.idle": "2026-10-04T09:18:36.546362Z",
     "shell.execute_reply": "2026-10-04T09:18:36.546362Z"
    },
    "id": "57ffa2aa",
    "outputId": "a18fb32c-1519-4946-f287-c5a2e857306c"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "bincount: 0.002705 seconds\n",
      "Python loop: 0.216494 seconds\n",
      "Speed-up: 80.03x\n"
     ]
    }
   ],
   "source": [
    "assert np.array_equal(vector_counts, loop_counts)\n",
    "speedup = loop_seconds / vector_seconds\n",
    "print(f\"bincount: {vector_seconds:.6f} seconds\")\n",
    "print(f\"Python loop: {loop_seconds:.6f} seconds\")\n",
    "print(f\"Speed-up: {speedup:.2f}x\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8fd2e0a7",
   "metadata": {
    "id": "8fd2e0a7"
   },
   "source": [
    "## 9. Sliding windows"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "41c7bf43",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.555514Z",
     "iopub.status.busy": "2026-10-04T09:18:36.555514Z",
     "iopub.status.idle": "2026-10-04T09:18:36.605665Z",
     "shell.execute_reply": "2026-10-04T09:18:36.605665Z"
    },
    "id": "41c7bf43",
    "outputId": "62bd5da9-834c-4753-ac6e-fdeb2c4d05bd"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Window shape: (9991, 10)\n",
      "Matches pandas: True\n"
     ]
    }
   ],
   "source": [
    "series_values = np.random.normal(size=10_000)\n",
    "windows = sliding_window_view(series_values, window_shape=10)\n",
    "window_means = windows.mean(axis=1)\n",
    "rolling_means = pd.Series(series_values).rolling(10).mean().iloc[9:].to_numpy()\n",
    "print(\"Window shape:\", windows.shape)\n",
    "print(\"Matches pandas:\", np.allclose(window_means, rolling_means))\n",
    "assert windows.shape == (9991, 10)\n",
    "assert np.allclose(window_means, rolling_means)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fc1f113c",
   "metadata": {
    "id": "fc1f113c"
   },
   "source": [
    "## 10. Reshape and average\n",
    "\n",
    "The output has shape (4, 8): four groups with eight features each.\n",
    "Each feature is the mean over the three rows belonging to its group."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "e3fc8a97",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.605665Z",
     "iopub.status.busy": "2026-10-04T09:18:36.605665Z",
     "iopub.status.idle": "2026-10-04T09:18:36.635764Z",
     "shell.execute_reply": "2026-10-04T09:18:36.635764Z"
    },
    "id": "e3fc8a97",
    "outputId": "5be9b02a-9f5d-45c2-d98e-30c74e32d6fa"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Result shape: (4, 8)\n",
      "[[ 8.  9. 10. 11. 12. 13. 14. 15.]\n",
      " [32. 33. 34. 35. 36. 37. 38. 39.]\n",
      " [56. 57. 58. 59. 60. 61. 62. 63.]\n",
      " [80. 81. 82. 83. 84. 85. 86. 87.]]\n"
     ]
    }
   ],
   "source": [
    "original = np.arange(12 * 8).reshape(12, 8)\n",
    "grouped = original.reshape(4, 3, 8)\n",
    "group_means = grouped.mean(axis=1)\n",
    "print(\"Result shape:\", group_means.shape)\n",
    "print(group_means)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7fbfde86",
   "metadata": {
    "id": "7fbfde86"
   },
   "source": [
    "## 11. Save and reload the cleaned array"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "f3a9677a",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "execution": {
     "iopub.execute_input": "2026-10-04T09:18:36.635764Z",
